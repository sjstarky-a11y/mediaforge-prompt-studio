# MediaForge Prompt Studio — v0.2-dev Adaptive Runtime
# Change these two values before install if the default ports are already in use.
MEDIAFORGE_APP_PORT=18888
MEDIAFORGE_OVMS_PORT=8010
MEDIAFORGE_IMAGE_PORT=8010

MEDIAFORGE_MODEL=ai/qwen2.5:3B-Q4_K_M
# Additional locally installed models are discovered automatically.
# Use .\manage-models.ps1 to list, install, recommend, or select a model.
MEDIAFORGE_DMR_URL=http://host.docker.internal:12434/engines/llama.cpp/v1
MEDIAFORGE_DMR_MANAGEMENT_URL=http://host.docker.internal:12434
MEDIAFORGE_DMR_API_KEY=docker-model-runner

MEDIAFORGE_IMAGE_API_URL=http://ovms-sdxl:8000/v3
MEDIAFORGE_IMAGE_MODEL=OpenVINO/stable-diffusion-xl-base-1.0-int8-ov
MEDIAFORGE_IMAGE_BACKEND=OpenVINO CPU
MEDIAFORGE_IMAGE_RUNTIME=auto
MEDIAFORGE_ACTIVE_IMAGE_RUNTIME=cpu
MEDIAFORGE_COMPOSE_FILE=docker-compose.yml

# NVIDIA profiles are selected automatically from capability and VRAM.
# 4-<6 GB: low_memory, 6-<8 GB: balanced, 8+ GB: full.
MEDIAFORGE_NVIDIA_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
MEDIAFORGE_NVIDIA_PROFILE=auto
MEDIAFORGE_NVIDIA_OFFLOAD_MODE=auto

# Legacy v0.1a aliases retained for compatible upgrades.
MEDIAFORGE_OVMS_IMAGE_URL=http://ovms-sdxl:8000/v3
MEDIAFORGE_OVMS_IMAGE_MODEL=OpenVINO/stable-diffusion-xl-base-1.0-int8-ov

MEDIAFORGE_RUNTIME_MODE=auto

# Resolved automatically by install.ps1; CPU is the safe initial value.
MEDIAFORGE_IMAGE_DEVICE=CPU
